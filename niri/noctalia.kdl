layout {

    focus-ring {
        active-color   "#c2cbe6"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c2cbe6"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c2cbe6"
        inactive-color "#a7b0ca"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c2cbe680"
    }
}

recent-windows {
    highlight {
        active-color "#c2cbe6"
        urgent-color "#ffb4ab"
    }
}
