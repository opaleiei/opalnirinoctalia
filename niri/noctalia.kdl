layout {

    focus-ring {
        active-color   "#e5f0f8"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e5f0f8"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e5f0f8"
        inactive-color "#c9d4dc"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e5f0f880"
    }
}

recent-windows {
    highlight {
        active-color "#e5f0f8"
        urgent-color "#ffb4ab"
    }
}
